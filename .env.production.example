# Copy to `.env` in /opt/pricewise on the EC2 host (docker-compose.prod.yml reads this file directly - it is
# never committed, never sent to GitHub, and never baked into a Docker image). Fill in every value below
# before running deploy/scripts/init-tls.sh or deploy/scripts/deploy.sh for the first time.

# --- Domain & TLS ---
DOMAIN_NAME=example.com
CERTBOT_EMAIL=you@example.com

# --- Images (built and pushed by .github/workflows/ci-cd.yml) ---
# Replace OWNER/REPO with your actual GitHub owner/repository, e.g. ghcr.io/janedoe/pricewise-backend:latest
BACKEND_IMAGE=ghcr.io/OWNER/REPO-backend:latest
FRONTEND_IMAGE=ghcr.io/OWNER/REPO-frontend:latest

# --- Postgres (used by both the postgres container and the backend's DATABASE_URL below) ---
POSTGRES_DB=pricewise
POSTGRES_USER=pricewise
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# --- Backend runtime config (app/core/config.py) ---
APP_ENV=production
DATABASE_URL=postgresql+psycopg://pricewise:replace-with-a-strong-random-password@postgres:5432/pricewise
REDIS_URL=redis://redis:6379/0
SUPABASE_URL=https://your-project.supabase.co
CORS_ORIGINS=https://example.com
GEMINI_API_KEY=replace-with-your-gemini-api-key
VOYAGE_API_KEY=replace-with-your-voyage-api-key
RECOMMENDATION_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMENSIONS=1024
ASSISTANT_CHAT_MODEL=gemini-3.1-flash-lite
ASSISTANT_EMBEDDING_MODEL=models/gemini-embedding-001
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Kore

# --- Frontend runtime config (src/shared/config/env.ts) ---
# NEXT_PUBLIC_APP_URL/NEXT_PUBLIC_SUPABASE_URL/NEXT_PUBLIC_SUPABASE_ANON_KEY are baked into the client bundle
# at image build time (see the frontend Dockerfile's build-args in ci-cd.yml) - the values here only matter
# for BACKEND_API_URL, which is read at request time on the server and always points at the backend over the
# private compose network.
NEXT_PUBLIC_APP_URL=https://example.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-publishable-key
BACKEND_API_URL=http://backend:8000/api/v1
